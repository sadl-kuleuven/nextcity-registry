  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/#copert-emission-factor">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/"/>
    <skos:prefLabel xml:lang="en">COPERT emission factor</skos:prefLabel>
    <skos:altLabel xml:lang="en">COPERT</skos:altLabel>
    <skos:scopeNote xml:lang="en">Speed-dependent vehicle emission factors, EF(v) = a/v + b + c·v, COPERT/HBEFA-consistent.</skos:scopeNote>
    <skos:definition xml:lang="en">Speed-dependent vehicle emission factors, EF(v) = a/v + b + c·v, COPERT/HBEFA-consistent.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/#idw-interpolation">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/"/>
    <skos:prefLabel xml:lang="en">IDW interpolation</skos:prefLabel>
    <skos:altLabel xml:lang="en">IDW</skos:altLabel>
    <skos:altLabel xml:lang="en">Inverse Distance Weighting</skos:altLabel>
    <skos:scopeNote xml:lang="en">Inverse Distance Weighting spatial interpolation.</skos:scopeNote>
    <skos:definition xml:lang="en">Inverse Distance Weighting spatial interpolation.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/#ordinary-kriging">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/"/>
    <skos:prefLabel xml:lang="en">Ordinary Kriging</skos:prefLabel>
    <skos:altLabel xml:lang="en">OK</skos:altLabel>
    <skos:scopeNote xml:lang="en">Geostatistical interpolation from a fitted variogram.</skos:scopeNote>
    <skos:definition xml:lang="en">Geostatistical interpolation from a fitted variogram.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/#leave-one-out-cross-validation">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/"/>
    <skos:prefLabel xml:lang="en">Leave-One-Out Cross-Validation</skos:prefLabel>
    <skos:altLabel xml:lang="en">LOOCV</skos:altLabel>
    <skos:scopeNote xml:lang="en">Withholds each observation in turn to compare methods.</skos:scopeNote>
    <skos:definition xml:lang="en">Withholds each observation in turn to compare methods.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/#comparative-risk-assessment">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/"/>
    <skos:prefLabel xml:lang="en">comparative risk assessment</skos:prefLabel>
    <skos:altLabel xml:lang="en">CRA</skos:altLabel>
    <skos:scopeNote xml:lang="en">Links exposure changes to health outcome changes via concentration-response functions.</skos:scopeNote>
    <skos:definition xml:lang="en">Links exposure changes to health outcome changes via concentration-response functions.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/#dasymetric-mapping">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/"/>
    <skos:prefLabel xml:lang="en">dasymetric mapping</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Redistributes areal counts to finer units using an ancillary layer.</skos:scopeNote>
    <skos:definition xml:lang="en">Redistributes areal counts to finer units using an ancillary layer.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/#proportional-area-allocation">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/"/>
    <skos:prefLabel xml:lang="en">proportional area allocation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Allocates quantities between overlapping polygons by intersecting area.</skos:scopeNote>
    <skos:definition xml:lang="en">Allocates quantities between overlapping polygons by intersecting area.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/#iterative-proportional-fitting">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/"/>
    <skos:prefLabel xml:lang="en">iterative proportional fitting</skos:prefLabel>
    <skos:altLabel xml:lang="en">IPF</skos:altLabel>
    <skos:scopeNote xml:lang="en">Adjusts a table so its margins match control totals.</skos:scopeNote>
    <skos:definition xml:lang="en">Adjusts a table so its margins match control totals.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/#spatial-join">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/"/>
    <skos:prefLabel xml:lang="en">spatial join</skos:prefLabel>
    <skos:altLabel xml:lang="en">point-in-polygon</skos:altLabel>
    <skos:scopeNote xml:lang="en">Attaches attributes by spatial relationship, e.g. point-in-polygon.</skos:scopeNote>
    <skos:definition xml:lang="en">Attaches attributes by spatial relationship, e.g. point-in-polygon.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/#ntc-temperature-scaling">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/algorithm/"/>
