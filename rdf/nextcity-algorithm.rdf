    <skos:prefLabel xml:lang="en">Ntc temperature scaling</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Linear scaling of the Ntc energy need to a temperature change (REH).</skos:scopeNote>
    <skos:definition xml:lang="en">Linear scaling of the Ntc energy need to a temperature change (REH).</skos:definition>
