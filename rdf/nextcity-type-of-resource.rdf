<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dct="http://purl.org/dc/terms/">
  <skos:ConceptScheme rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/type-of-resource/">
    <dc:title xml:lang="en">NextCity Type of Resource</dc:title>
    <skos:prefLabel xml:lang="en">NextCity Type of Resource</skos:prefLabel>
    <dc:description xml:lang="en">Top-level classification of a tool record. Exactly one value per record: it tells users whether a resource is an interactive application or an algorithm, and if an algorithm, whether it is machine-learning based.</dc:description>
    <dc:creator>NextCity Project Consortium</dc:creator>
    <dct:issued>2026-11-13</dct:issued>
    <skos:hasTopConcept rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/type-of-resource/#tool"/>
    <skos:hasTopConcept rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/type-of-resource/#ml-dl-algorithm"/>
    <skos:hasTopConcept rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/type-of-resource/#other-algorithm"/>
  </skos:ConceptScheme>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/type-of-resource/#tool">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/type-of-resource/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/type-of-resource/"/>
    <skos:prefLabel xml:lang="en">tool</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Interactive software with a user-facing interface, such as the NextCity digital twin, dashboards or web apps.</skos:scopeNote>
    <skos:definition xml:lang="en">Interactive software with a user-facing interface, such as the NextCity digital twin, dashboards or web apps.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/type-of-resource/#ml-dl-algorithm">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/type-of-resource/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/type-of-resource/"/>
    <skos:prefLabel xml:lang="en">ML/DL algorithm</skos:prefLabel>
    <skos:altLabel xml:lang="en">machine learning algorithm</skos:altLabel>
    <skos:scopeNote xml:lang="en">Machine learning or deep learning model (supervised, unsupervised, reinforcement learning, etc.).</skos:scopeNote>
    <skos:definition xml:lang="en">Machine learning or deep learning model (supervised, unsupervised, reinforcement learning, etc.).</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/type-of-resource/#other-algorithm">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/type-of-resource/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/type-of-resource/"/>
    <skos:prefLabel xml:lang="en">other algorithm</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Computational algorithm not based on ML/DL, such as physically-structured models, emission factor chains, statistical and geostatistical methods, and data pipelines.</skos:scopeNote>
    <skos:definition xml:lang="en">Computational algorithm not based on ML/DL, such as physically-structured models, emission factor chains, statistical and geostatistical methods, and data pipelines.</skos:definition>
  </skos:Concept>
</rdf:RDF>
