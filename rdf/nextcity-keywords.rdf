  <skos:ConceptScheme rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/nextcity-keywords/">
    <dc:title xml:lang="en">NextCity NextCity Dataset Keywords</dc:title>
    <skos:prefLabel xml:lang="en">NextCity NextCity Dataset Keywords</skos:prefLabel>
    <dc:description xml:lang="en">A single shared vocabulary for tagging NextCity datasets. It covers the use case, place, theme, indicators, spatial unit, source data, production method and role of a dataset, so any dataset can be found by what it contains, where it comes from and how it was made. Pick every term that applies.</dc:description>
    <dc:creator>NextCity Project Consortium</dc:creator>
    <dct:issued>2026-11-13</dct:issued>
