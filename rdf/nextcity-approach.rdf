<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dct="http://purl.org/dc/terms/">
  <skos:ConceptScheme rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/approach/">
    <dc:title xml:lang="en">Approach</dc:title>
    <skos:prefLabel xml:lang="en">Approach</skos:prefLabel>
    <dc:description xml:lang="en">The methodological paradigm or learning modality behind a tool. Mandatory for ML/DL algorithms; recommended for all algorithms so users know what kind of reasoning produces the outputs.</dc:description>
    <dc:creator>NextCity Project Consortium</dc:creator>
    <dct:issued>2026-11-13</dct:issued>
    <skos:hasTopConcept rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/#physically-structured-scenario-model"/>
