    <skos:hasTopConcept rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/#geostatistics"/>
    <skos:hasTopConcept rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/#rule-based"/>
    <skos:hasTopConcept rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/#supervised-learning"/>
    <skos:hasTopConcept rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/#unsupervised-learning"/>
    <skos:hasTopConcept rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/#semi-supervised-learning"/>
    <skos:hasTopConcept rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/#reinforcement-learning"/>
    <skos:hasTopConcept rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/#transfer-learning"/>
    <skos:hasTopConcept rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/#physics-informed-ml"/>
  </skos:ConceptScheme>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/approach/#physically-structured-scenario-model">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/"/>
    <skos:prefLabel xml:lang="en">physically-structured scenario model</skos:prefLabel>
    <skos:altLabel xml:lang="en">physics-based</skos:altLabel>
    <skos:scopeNote xml:lang="en">Structure from physical laws or literature-anchored coefficients; not trained on local data.</skos:scopeNote>
    <skos:definition xml:lang="en">Structure from physical laws or literature-anchored coefficients; not trained on local data.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/approach/#statistical-modelling">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/"/>
    <skos:prefLabel xml:lang="en">statistical modelling</skos:prefLabel>
    <skos:altLabel xml:lang="en">statistics-based</skos:altLabel>
    <skos:scopeNote xml:lang="en">Statistical estimation, allocation or epidemiological methods without an ML training loop.</skos:scopeNote>
    <skos:definition xml:lang="en">Statistical estimation, allocation or epidemiological methods without an ML training loop.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/approach/#geostatistics">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/"/>
    <skos:prefLabel xml:lang="en">geostatistics</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Spatial statistical modelling of continuous phenomena from point observations.</skos:scopeNote>
    <skos:definition xml:lang="en">Spatial statistical modelling of continuous phenomena from point observations.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/approach/#rule-based">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/"/>
    <skos:prefLabel xml:lang="en">rule-based</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Explicit hand-crafted logical rules or thresholds.</skos:scopeNote>
    <skos:definition xml:lang="en">Explicit hand-crafted logical rules or thresholds.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/approach/#supervised-learning">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/"/>
    <skos:prefLabel xml:lang="en">supervised learning</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Trained on labelled input-output pairs.</skos:scopeNote>
    <skos:definition xml:lang="en">Trained on labelled input-output pairs.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/approach/#unsupervised-learning">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/"/>
    <skos:prefLabel xml:lang="en">unsupervised learning</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Discovers structure in unlabelled data.</skos:scopeNote>
    <skos:definition xml:lang="en">Discovers structure in unlabelled data.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/approach/#semi-supervised-learning">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/"/>
    <skos:prefLabel xml:lang="en">semi-supervised learning</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Mix of labelled and unlabelled data.</skos:scopeNote>
    <skos:definition xml:lang="en">Mix of labelled and unlabelled data.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/approach/#reinforcement-learning">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/"/>
    <skos:prefLabel xml:lang="en">reinforcement learning</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Learns through environment interaction and reward.</skos:scopeNote>
    <skos:definition xml:lang="en">Learns through environment interaction and reward.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/approach/#transfer-learning">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/"/>
    <skos:prefLabel xml:lang="en">transfer learning</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Pre-trained model adapted to a new domain.</skos:scopeNote>
    <skos:definition xml:lang="en">Pre-trained model adapted to a new domain.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/approach/#physics-informed-ml">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/approach/"/>
    <skos:prefLabel xml:lang="en">physics-informed ML</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Hybrid combining physical equations with ML components.</skos:scopeNote>
    <skos:definition xml:lang="en">Hybrid combining physical equations with ML components.</skos:definition>
  </skos:Concept>
</rdf:RDF>
