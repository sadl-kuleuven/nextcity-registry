<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dct="http://purl.org/dc/terms/">
  <skos:ConceptScheme rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/processor/">
    <dc:title xml:lang="en">NextCity Processor</dc:title>
    <skos:prefLabel xml:lang="en">NextCity Processor</skos:prefLabel>
    <dc:description xml:lang="en">The type of processor a tool needs. Select the highest-power processor used. Mandatory for ML/DL algorithms.</dc:description>
    <dc:creator>NextCity Project Consortium</dc:creator>
    <dct:issued>2026-11-13</dct:issued>
    <skos:hasTopConcept rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/processor/#cpu"/>
    <skos:hasTopConcept rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/processor/#gpu"/>
    <skos:hasTopConcept rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/processor/#tpu"/>
    <skos:hasTopConcept rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/processor/#fpga"/>
  </skos:ConceptScheme>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/processor/#cpu">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/processor/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/processor/"/>
    <skos:prefLabel xml:lang="en">CPU</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Standard processor; no specialised hardware required.</skos:scopeNote>
    <skos:definition xml:lang="en">Standard processor; no specialised hardware required.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/processor/#gpu">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/processor/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/processor/"/>
    <skos:prefLabel xml:lang="en">GPU</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Graphics processor, for deep learning or GPU rendering such as WebGL map layers.</skos:scopeNote>
    <skos:definition xml:lang="en">Graphics processor, for deep learning or GPU rendering such as WebGL map layers.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/processor/#tpu">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/processor/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/processor/"/>
    <skos:prefLabel xml:lang="en">TPU</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Google Tensor Processing Unit for ML workloads.</skos:scopeNote>
    <skos:definition xml:lang="en">Google Tensor Processing Unit for ML workloads.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://sadl-kuleuven.github.io/nextcity-registry/processor/#fpga">
    <skos:inScheme rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/processor/"/>
    <skos:topConceptOf rdf:resource="https://sadl-kuleuven.github.io/nextcity-registry/processor/"/>
    <skos:prefLabel xml:lang="en">FPGA</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Reconfigurable hardware for edge inference.</skos:scopeNote>
    <skos:definition xml:lang="en">Reconfigurable hardware for edge inference.</skos:definition>
  </skos:Concept>
</rdf:RDF>
